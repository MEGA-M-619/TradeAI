// TradeAI schema.
// Phase 0: tenant/authentication foundation (organizations, users,
// organization_memberships).
// Phase 1 adds: customers, jobs.
// Phase 2 adds: evidence (job photos).
// Phase 3 adds: AI/vision-assisted assessment.
// Phase 4 adds: circuits and structured measurements (Intelligence Layer
// foundation -- see docs/architecture/ai-assessment.md and the approved
// Intelligence Layer architecture analysis for how this and later phases
// fit together).
// Materials adds: manual-entry job material line items (quantity, unit
// cost) -- the first step past confirmed findings toward a quote.
// Quote adds: one current quote per job, generated from confirmed
// findings and materials, plus manually-added labor line items.
// Every other domain table is added in later phases per the approved
// architecture.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url / directUrl are configured in prisma.config.ts (Prisma 7 pattern),
  // not here.
}

enum OrganizationRole {
  owner
  admin
  electrician

  @@map("organization_role")
}

/// A tenant. All tenant-scoped tables carry an organizationId that must
/// match app.current_org_id, enforced by both the repository layer and
/// PostgreSQL RLS (see prisma/migrations/*_tenant_rls/migration.sql).
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships               OrganizationMembership[]
  customers                 Customer[]
  jobs                      Job[]
  evidence                  Evidence[]
  aiAssessments             AiAssessment[]
  technicianVerdicts        TechnicianVerdict[]
  aiUsageLedger             AiUsageLedger[]
  circuits                  Circuit[]
  measurements              Measurement[]
  diagnosticSessions        DiagnosticSession[]
  diagnosticCandidateCauses DiagnosticCandidateCause[]
  materials                 Material[]
  quotes                    Quote[]
  quoteLineItems            QuoteLineItem[]

  @@map("organizations")
}

/// App-level profile for a Supabase Auth user. `id` is the same UUID as
/// the corresponding row in Supabase's auth.users table (linked via a raw
/// SQL foreign key added in the RLS migration, since auth.users lives
/// outside the schema Prisma manages). A user is never scoped to a single
/// organization — org access is entirely determined by
/// organization_memberships.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships               OrganizationMembership[]
  jobsCreated               Job[]
  evidenceUploaded          Evidence[]                 @relation("EvidenceUploadedBy")
  evidenceDeleted           Evidence[]                 @relation("EvidenceDeletedBy")
  assessmentsRequested      AiAssessment[]             @relation("AssessmentRequestedBy")
  verdictsGiven             TechnicianVerdict[]        @relation("VerdictCreatedBy")
  measurementsRecorded      Measurement[]              @relation("MeasurementRecordedBy")
  diagnosticSessionsCreated DiagnosticSession[]        @relation("DiagnosticSessionCreatedBy")
  diagnosticCausesCreated   DiagnosticCandidateCause[] @relation("DiagnosticCandidateCauseCreatedBy")
  materialsCreated          Material[]
  quotesCreated             Quote[]

  @@map("users")
}

/// The join table that is the single source of truth for tenant access:
/// "is user X allowed to act within organization Y, and with what role."
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// A tenant's customer. organizationId is carried directly (not derived
/// via a join) so RLS policies can gate every command on it uniformly,
/// matching the pattern used throughout Phase 0.
model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]
  circuits     Circuit[]

  @@index([organizationId])
  @@map("customers")
}

/// Minimal lifecycle for Phase 1. Deliberately not modeling AI-assessment
/// or quote-related states yet -- those states belong to the phases that
/// actually implement AI assessment and quoting, and adding them now
/// would be designing for features that don't exist.
enum JobStatus {
  open
  in_progress
  completed

  @@map("job_status")
}

model Job {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  title              String
  problemDescription String?   @map("problem_description")
  status             JobStatus @default(open)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  evidence           Evidence[]
  assessments        AiAssessment[]
  measurements       Measurement[]
  diagnosticSessions DiagnosticSession[]
  materials          Material[]
  quote              Quote?

  @@index([organizationId])
  @@index([customerId])
  @@map("jobs")
}

/// Only `photo` is implemented. Originally reserved for measurement rows
/// too (see the old comment on this enum in Phase 2), but Phase 4 modeled
/// measurements as their own table instead: a numeric reading has no
/// bytes to store and doesn't fit this table's upload-object model. See
/// the `Measurement` model, which optionally links back to an Evidence
/// photo (e.g. a photo of a multimeter display) via a nullable
/// `evidenceId`, rather than being an EvidenceKind variant. The
/// discriminator stays for the still-future `document` case.
enum EvidenceKind {
  photo

  @@map("evidence_kind")
}

/// Direct-to-storage upload makes the database row and the stored bytes
/// two separate writes that can diverge. The row is created `pending`
/// before the client uploads and is only moved to `ready` by the confirm
/// endpoint, so a failure leaves a reapable row rather than an invisible
/// orphaned object. Only `ready` rows are ever shown.
enum EvidenceUploadStatus {
  pending
  ready

  @@map("evidence_upload_status")
}

/// A photo (later: document) attached to a job. Measurements are modeled
/// separately -- see `Measurement` -- rather than as a kind of Evidence.
///
/// Deletion is deliberately asymmetric: the Storage object is hard-deleted
/// (these are photos inside a customer's home -- privacy and storage cost
/// are both real), but the row is tombstoned via deletedAt/deletedByUserId
/// so a later AI assessment that cited this evidence can say "this was
/// deleted" instead of dangling against a missing id.
model Evidence {
  id               String               @id @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  jobId            String               @map("job_id") @db.Uuid
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  kind             EvidenceKind         @default(photo)
  uploadStatus     EvidenceUploadStatus @default(pending) @map("upload_status")
  /// Server-derived, never client-supplied: `{organizationId}/{jobId}/{id}`.
  /// The storage RLS policies re-validate this exact shape independently.
  storageKey       String               @unique @map("storage_key")
  mimeType         String               @map("mime_type")
  byteSize         Int?                 @map("byte_size")
  width            Int?
  height           Int?
  /// Client-asserted, not server-verified -- with direct-to-storage upload
  /// the server never sees the bytes. Named as a claim on purpose, matching
  /// the app's fact-vs-inference discipline.
  clientSha256     String?              @map("client_sha256")
  caption          String?
  capturedAt       DateTime?            @map("captured_at") @db.Timestamptz(6)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId  String?              @map("deleted_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy       User                @relation("EvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  deletedBy        User?               @relation("EvidenceDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  assessmentInputs AiAssessmentInput[]
  measurements     Measurement[]

  @@index([organizationId])
  @@index([jobId])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Phase 3: AI/vision-assisted assessment.
//
// The governing rule for everything below: the model produces inferences,
// never facts. Every table is explicitly tagged in its own comment as either
// DETERMINISTIC (application-owned, testable, a bug if wrong) or INFERENCE
// (model-proposed, always attributed, never authoritative). A technician
// verdict is its own table, not a mutation of a finding, so both survive
// independently and permanently -- confirming or rejecting a hypothesis
// never rewrites what the model actually said.
//
// See docs/architecture/ai-assessment.md for the full design rationale,
// including why citation integrity is enforced by a database constraint
// (ai_assessment_citation's composite FK into ai_assessment_input) rather
// than by application validation alone.

enum AssessmentStatus {
  queued
  running
  complete
  insufficient_evidence
  failed

  @@map("assessment_status")
}

enum AssessmentModelTier {
  standard
  escalation

  @@map("assessment_model_tier")
}

enum AssessmentFailureCategory {
  quota_exceeded
  sha_mismatch
  /// The selected evidence exceeded a server-side payload limit (per-image
  /// bytes, total bytes, or image count) -- see lib/ai/imagePayload.ts.
  /// Distinguished from model_error on purpose: this is a request this
  /// application declined to make, not a call the provider failed.
  payload_too_large
  /// The stored bytes are not one of the supported image formats, or do
  /// not match the mime type recorded on the evidence row. Checked against
  /// the actual downloaded bytes, never the client's declared type alone.
  unsupported_media_type
  model_error
  schema_violation
  citation_violation
  timeout
  unknown

  @@map("assessment_failure_category")
}

enum FindingKind {
  observation
  hypothesis

  @@map("finding_kind")
}

enum ConfidenceLevel {
  low
  medium
  high

  @@map("confidence_level")
}

enum SafetySeverity {
  advisory
  mandatory
  stop_work

  @@map("safety_severity")
}

enum VerdictKind {
  confirmed
  rejected
  amended
  unresolved

  @@map("verdict_kind")
}

/// DETERMINISTIC. One assessment run against a job's selected evidence.
/// Append-only: re-running creates a new row with the next `version` for
/// this job (see @@unique([jobId, version])) -- this row is never mutated
/// again once it leaves queued/running. `rawResponse` is retained verbatim
/// even on failure so a bad run can be diagnosed without re-calling the
/// model. `claimedAt` exists so a stuck `running` row can be identified and
/// reaped (see the reap_stuck_ai_assessments() function in the RLS
/// migration) without a separate job-queue table.
model AiAssessment {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                     @map("organization_id") @db.Uuid
  jobId               String                     @map("job_id") @db.Uuid
  requestedByUserId   String                     @map("requested_by_user_id") @db.Uuid
  version             Int
  status              AssessmentStatus           @default(queued)
  /// The technician's evidence selection, recorded at request time (a
  /// verified, authorized, deterministic act) as plain ids -- before the
  /// executor has fetched or verified any bytes. This is a handoff field
  /// only: once ai_assessment_input rows exist for this assessment they
  /// are the source of truth for what was actually sent to the model.
  /// Kept permanently for audit (what was *requested* vs. what actually
  /// got verified and used).
  selectedEvidenceIds String[]                   @default([]) @map("selected_evidence_ids")
  modelTier           AssessmentModelTier        @default(standard) @map("model_tier")
  /// Exact model ID used, e.g. "claude-sonnet-5" -- stored verbatim, never
  /// inferred from modelTier, so a provider default change doesn't silently
  /// rewrite history.
  modelId             String                     @map("model_id")
  promptVersion       String                     @map("prompt_version")
  schemaVersion       String                     @map("schema_version")
  modelParams         Json?                      @map("model_params")
  inputTokens         Int?                       @map("input_tokens")
  outputTokens        Int?                       @map("output_tokens")
  latencyMs           Int?                       @map("latency_ms")
  stopReason          String?                    @map("stop_reason")
  /// Verbatim provider response. Never rendered to end users directly --
  /// exists for debugging and reproducibility, not for display.
  rawResponse         Json?                      @map("raw_response")
  insufficientReason  String?                    @map("insufficient_reason")
  /// INFERENCE (model-authored, like insufficientReason above -- the two
  /// exceptions to this table being otherwise deterministic). What the
  /// model itself said it could not determine from the photographs it was
  /// given. Required of the model by modelOutputSchema and validated
  /// before it reaches here, so this is never free-form text that skipped
  /// validation. Stored on the assessment rather than in a child table:
  /// it is a bounded (<=10), ordered list of plain strings that is never
  /// individually addressed, cited, or verdicted -- the same shape as
  /// answersWouldRuleIn on AiAssessmentQuestion.
  ///
  /// Shown to the technician. A stated limitation is a safety signal, not
  /// a footnote: it is the model's own account of what it could not see.
  limitations         String[]                   @default([])
  failureCategory     AssessmentFailureCategory? @map("failure_category")
  errorMessage        String?                    @map("error_message")
  claimedAt           DateTime?                  @map("claimed_at") @db.Timestamptz(6)
  completedAt         DateTime?                  @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy    User                        @relation("AssessmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  inputs         AiAssessmentInput[]
  findings       AiAssessmentFinding[]
  questions      AiAssessmentQuestion[]
  safetyWarnings AiAssessmentSafetyWarning[]
  usageLedger    AiUsageLedger[]

  @@unique([jobId, version])
  @@index([organizationId])
  @@index([jobId])
  @@index([status, claimedAt])
  @@map("ai_assessment")
}

/// DETERMINISTIC. The exact evidence sent to the model for one run, with
/// the ordinal reference (E1..E8) shown to the model instead of a database
/// id, and the sha256 the server itself computed after fetching the bytes
/// (see lib/storage/evidenceStorage.ts) -- never the client's unverified
/// claim. This snapshot is the anchor that makes citation integrity
/// possible: ai_assessment_citation can only reference an
/// (assessmentId, evidenceId) pair that exists here.
model AiAssessmentInput {
  assessmentId   String   @map("assessment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  ordinalRef     String   @map("ordinal_ref")
  sha256Verified String   @map("sha256_verified")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment AiAssessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidence   Evidence               @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  citations  AiAssessmentCitation[]

  @@id([assessmentId, evidenceId])
  @@unique([assessmentId, ordinalRef])
  @@index([organizationId])
  @@map("ai_assessment_input")
}

/// INFERENCE. One observation or hypothesis from the model. `kind`
/// discriminates the two: an observation describes what is visible;
/// a hypothesis proposes an explanation and must carry
/// `whatWouldChangeMyMind` plus at least one AiAssessmentTest (enforced at
/// the Zod layer, not by a DB constraint -- see lib/validation/assessment.ts).
/// `safetyCategories` is a closed vocabulary the deterministic safety layer
/// (lib/ai/safetyRules.ts) reads to emit warnings; it is data the model
/// selects from a fixed list, not free text the model writes.
model AiAssessmentFinding {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId          String          @map("assessment_id") @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  kind                  FindingKind
  /// Model-facing ref, e.g. "O1" or "H1" -- unique within the assessment,
  /// used for citation display and for the technician-verdict UI, never a
  /// database id.
  ref                   String
  statement             String
  confidence            ConfidenceLevel
  rationale             String
  whatWouldChangeMyMind String?         @map("what_would_change_my_mind")
  safetyCategories      String[]        @map("safety_categories")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment AiAssessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  citations  AiAssessmentCitation[]
  tests      AiAssessmentTest[]
  verdict    TechnicianVerdict?

  @@unique([assessmentId, id])
  @@unique([assessmentId, ref])
  @@index([organizationId])
  @@index([assessmentId])
  @@map("ai_assessment_finding")
}

/// DB-ENFORCED. The citation-integrity mechanism: a row here can only exist
/// if (assessmentId, evidenceId) already exists in ai_assessment_input --
/// i.e. that exact evidence was actually sent to the model in that exact
/// run. A model-invented evidence id was never in the input snapshot, so
/// Postgres rejects the insert outright; the persistence step wraps all
/// writes for one assessment in a single transaction, so one bad citation
/// fails the whole run rather than partially persisting. See
/// lib/db/repositories/assessmentRepository.ts persist().
model AiAssessmentCitation {
  assessmentId   String @map("assessment_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  findingId      String @map("finding_id") @db.Uuid
  evidenceId     String @map("evidence_id") @db.Uuid

  finding AiAssessmentFinding @relation(fields: [assessmentId, findingId], references: [assessmentId, id], onDelete: Cascade)
  input   AiAssessmentInput   @relation(fields: [assessmentId, evidenceId], references: [assessmentId, evidenceId], onDelete: Cascade)

  @@id([assessmentId, findingId, evidenceId])
  @@index([organizationId])
  @@map("ai_assessment_citation")
}

/// INFERENCE. A discriminating test attached to a hypothesis -- "what would
/// tell you whether this is right." Required (at the Zod layer) for every
/// hypothesis so a hypothesis can never be pure assertion.
model AiAssessmentTest {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId       String   @map("assessment_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  findingId          String   @map("finding_id") @db.Uuid
  test               String
  rulesInIfPositive  String   @map("rules_in_if_positive")
  rulesOutIfNegative String   @map("rules_out_if_negative")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  finding AiAssessmentFinding @relation(fields: [assessmentId, findingId], references: [assessmentId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assessmentId])
  @@map("ai_assessment_test")
}

/// INFERENCE. A follow-up question the model would ask the technician.
/// Phase 3 only captures these as structured output -- answering one and
/// re-assessing from the answer is the Phase 3.5 multi-turn loop.
model AiAssessmentQuestion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId       String   @map("assessment_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  question           String
  whyItMatters       String   @map("why_it_matters")
  answersWouldRuleIn String[] @map("answers_would_rule_in")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment AiAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assessmentId])
  @@map("ai_assessment_question")
}

/// DETERMINISTIC. A mandatory warning emitted by the safety rules engine
/// (lib/ai/safetyRules.ts), a pure function with no model involvement.
/// `message` is always a constant from the codebase, never model-generated
/// text -- see the module for why this must not depend on a good
/// generation. `ruleId` identifies which rule fired, for auditability.
model AiAssessmentSafetyWarning {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String         @map("assessment_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ruleId         String         @map("rule_id")
  severity       SafetySeverity
  message        String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment AiAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assessmentId])
  @@map("ai_assessment_safety_warning")
}

/// DETERMINISTIC (human fact). The technician's judgment on one finding --
/// confirmed, rejected, amended, or left unresolved. Deliberately its own
/// table rather than a field on AiAssessmentFinding: the finding is what
/// the model said and never changes; the verdict is what the technician
/// decided and can be revised as work progresses (unique on findingId,
/// upserted). Losing either one loses real information.
model TechnicianVerdict {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  assessmentId    String      @map("assessment_id") @db.Uuid
  findingId       String      @unique @map("finding_id") @db.Uuid
  verdict         VerdictKind
  note            String?
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding      AiAssessmentFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("VerdictCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([assessmentId])
  @@map("technician_verdict")
}

/// DETERMINISTIC. One row per model call attempt (including failures --
/// a failed call still costs tokens and must be visible in cost
/// attribution). This is the token/cost observability record; the
/// per-organization monthly quota is enforced separately by counting
/// AiAssessment rows directly (see assessmentRepository.countThisMonth),
/// so quota enforcement does not depend on this table being consistent.
model AiUsageLedger {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assessmentId   String?  @map("assessment_id") @db.Uuid
  /// 'YYYY-MM', UTC. Plain text rather than a date so "the org's usage for
  /// this calendar month" is a direct equality match, not a range query.
  billingPeriod  String   @map("billing_period")
  modelId        String   @map("model_id")
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  succeeded      Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   AiAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, billingPeriod])
  @@map("ai_usage_ledger")
}

// ---------------------------------------------------------------------------
// Phase 4: circuits and structured measurements (Intelligence Layer
// foundation).
//
// Deliberately independent of the Phase 3 AI-assessment tables in this
// phase: nothing here is read or written by lib/ai/executor.ts yet, and no
// AiAssessmentCitation-style DB-enforced link into these tables exists.
// That integration is a later, separately-planned phase.
//
// A circuit is scoped to the customer, not the job: a panel or branch
// circuit is a physical thing that persists across visits, which is
// exactly what job-memory queries need to walk. A measurement is scoped to
// the job it was taken during (plus, optionally, the circuit it was taken
// on), matching how Evidence is scoped to the job it was captured for.

enum MeasurementTestType {
  voltage_ac
  voltage_dc
  continuity
  resistance
  current_ac
  current_dc
  insulation_resistance
  ground_impedance

  @@map("measurement_test_type")
}

enum MeasurementResult {
  pass
  fail
  inconclusive
  not_applicable

  @@map("measurement_result")
}

/// A customer's panel or branch circuit. Scoped to the customer (not the
/// job) because it outlives any single visit -- job memory depends on
/// being able to walk one circuit's measurement history across many jobs.
/// onDelete: Restrict on customerId matches Job's pattern: a circuit with
/// recorded history should never be silently cascaded away by a customer
/// delete.
model Circuit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  label          String
  panelLabel     String?  @map("panel_label")
  breakerRating  Int?     @map("breaker_rating")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  measurements Measurement[]

  @@index([organizationId])
  @@index([customerId])
  @@map("circuits")
}

/// DETERMINISTIC -- entirely technician-recorded, unlike the Phase 3 AI
/// tables there is no model-authored content here at all. A structured
/// test recorded against a job, optionally tied to a circuit and
/// optionally to an Evidence photo (e.g. a photo of the multimeter
/// display) -- never the other way around; Evidence.kind stays photo-only
/// (see EvidenceKind). `value`/`unit` are the raw reading;
/// `expectedMin`/`expectedMax` are the acceptable range the technician
/// supplied. `result` is deliberately nullable: it must be computed from
/// those by a deterministic rule engine, never chosen freehand, and that
/// engine (lib/diagnostics/measurementRules.ts) is a later step -- rows
/// created before it ships simply have no result until backfilled.
model Measurement {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  jobId            String              @map("job_id") @db.Uuid
  circuitId        String?             @map("circuit_id") @db.Uuid
  evidenceId       String?             @map("evidence_id") @db.Uuid
  recordedByUserId String              @map("recorded_by_user_id") @db.Uuid
  testType         MeasurementTestType @map("test_type")
  value            Float
  unit             String
  expectedMin      Float?              @map("expected_min")
  expectedMax      Float?              @map("expected_max")
  result           MeasurementResult?
  note             String?
  recordedAt       DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  circuit         Circuit?                   @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  evidence        Evidence?                  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  recordedBy      User                       @relation("MeasurementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  resolvingCauses DiagnosticCandidateCause[]

  @@index([organizationId])
  @@index([jobId])
  @@index([circuitId])
  @@map("measurements")
}

// ---------------------------------------------------------------------------
// Phase 3A: diagnostic sessions (Diagnostic Engine foundation).
//
// Deliberately independent of the Phase 3 (original numbering)
// AiAssessment tables: a DiagnosticSession is never a version of an
// AiAssessment and nothing here is read or written by lib/ai/executor.ts.
// See docs/architecture/diagnostics.md for why these stayed separate
// rather than extending AiAssessment.
//
// DETERMINISTIC throughout (human fact, like TechnicianVerdict) -- there
// is no model-authored content anywhere in this section in this phase. A
// DiagnosticCandidateCause.status can only ever be set by a technician;
// lib/db/repositories/diagnosticCauseRepository.ts enforces the "at most
// one confirmed cause per session" invariant and the "confirming a cause
// moves its session to diagnosed" transition -- neither is a DB
// constraint, both are documented there.

enum DiagnosticSessionStatus {
  open
  investigating
  diagnosed
  abandoned

  @@map("diagnostic_session_status")
}

enum DiagnosticCauseStatus {
  candidate
  confirmed
  ruled_out

  @@map("diagnostic_cause_status")
}

/// A structured troubleshooting thread for a job: a symptom statement plus
/// a status that only ever moves forward through repository-enforced
/// transitions (see diagnosticCauseRepository.update). `symptom` may start
/// pre-filled from Job.problemDescription by the UI layer, but is its own
/// field -- a job can have more than one session (e.g. an electrician
/// finds a second, unrelated issue mid-visit), and a symptom statement can
/// be refined independently of the job's original problem description.
model DiagnosticSession {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  jobId           String                  @map("job_id") @db.Uuid
  symptom         String
  status          DiagnosticSessionStatus @default(open)
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("DiagnosticSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  causes       DiagnosticCandidateCause[]

  @@index([organizationId])
  @@index([jobId])
  @@map("diagnostic_sessions")
}

/// A technician's hypothesis for what's causing a DiagnosticSession's
/// symptom. `status` starts at `candidate` and is only ever moved through
/// diagnosticCauseRepository.update -- never set directly at creation, so
/// the "at most one confirmed cause per session" check has exactly one
/// code path to guard, not two.
///
/// `resolvingMeasurementId` is informational, not causal: linking a
/// Measurement here never by itself changes `status`. Whether a given
/// measurement's pass/fail confirms or rules out a *specific* candidate
/// cause is domain judgment this codebase has no verified authority to
/// automate -- the same reasoning that keeps
/// lib/diagnostics/measurementRules.ts free of invented thresholds. See
/// docs/architecture/diagnostics.md.
model DiagnosticCandidateCause {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  diagnosticSessionId    String                @map("diagnostic_session_id") @db.Uuid
  statement              String
  status                 DiagnosticCauseStatus @default(candidate)
  recommendedNextTest    String?               @map("recommended_next_test")
  resolvingMeasurementId String?               @map("resolving_measurement_id") @db.Uuid
  createdByUserId        String                @map("created_by_user_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session              DiagnosticSession @relation(fields: [diagnosticSessionId], references: [id], onDelete: Cascade)
  resolvingMeasurement Measurement?      @relation(fields: [resolvingMeasurementId], references: [id], onDelete: SetNull)
  createdBy            User              @relation("DiagnosticCandidateCauseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([diagnosticSessionId])
  @@map("diagnostic_candidate_causes")
}

// ---------------------------------------------------------------------------
// Materials: manual-entry job material line items.
//
// DETERMINISTIC, technician-recorded only -- there is no model-authored
// content here, the same category as Measurement and TechnicianVerdict.
// `source` is carried as an enum with a single value today rather than a
// plain default so a later catalog/supplier-integration source is an
// additive enum variant, not a column rename.
//
// unitCostCents is integer cents, not a decimal/float price: money stored
// as a float accumulates rounding error the moment a quote sums these
// rows, and Postgres has no fixed-point type simpler to reason about than
// "the smallest unit, as an integer."

enum MaterialSource {
  manual

  @@map("material_source")
}

/// A single material line item against a job, entered by a technician
/// after reviewing confirmed findings. Hard-deletable (unlike Evidence):
/// nothing else in the schema cites a Material by id, so there is no
/// dangling-reference case a tombstone would need to explain.
model Material {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  description     String
  quantity        Float
  unitCostCents   Int            @map("unit_cost_cents")
  source          MaterialSource @default(manual)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  quoteLines   QuoteLineItem[]

  @@index([organizationId])
  @@index([jobId])
  @@map("materials")
}

// ---------------------------------------------------------------------------
// Quote: one current quote per job.
//
// DETERMINISTIC, technician-recorded/system-computed only -- there is no
// model-authored content here. jobId is unique, so a job can never have
// more than one Quote row; this phase has no versioning/history, and
// regenerating an existing quote is refused by quoteRepository rather
// than silently discarding a technician's edits (see the doc comment on
// QuoteAlreadyExistsError).
//
// subtotalCents/totalCents are stored, not computed on every read, but
// are never client-supplied: quoteRepository recomputes both from the
// persisted line items inside the same transaction as every mutation and
// overwrites them there. totalCents duplicates subtotalCents today (no
// tax/discount exists in this schema) but is a real, separately-stored
// column so a future tax/discount phase is an additive computation, not a
// schema change.

enum QuoteLineItemKind {
  material
  labor

  @@map("quote_line_item_kind")
}

model Quote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  jobId           String   @unique @map("job_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  subtotalCents   Int      @default(0) @map("subtotal_cents")
  totalCents      Int      @default(0) @map("total_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lineItems    QuoteLineItem[]

  @@index([organizationId])
  @@map("quotes")
}

/// A single billable line on a quote. `kind` records provenance --
/// `material` lines are only ever created by quoteRepository.generate,
/// snapshotted from the job's current Materials; `labor` is the only kind
/// a technician can add directly through the API (see the route). Both
/// kinds are equally editable/deletable afterward -- kind is where a row
/// came from, not a restriction on what can be done to it later.
///
/// description/quantity/unitPriceCents are a snapshot taken when the line
/// was created, deliberately independent of the source Material from then
/// on -- editing a Material later must never silently rewrite a quote a
/// technician already reviewed. sourceMaterialId is provenance only
/// (nullable, SetNull on delete): nothing reads it back to recompute
/// anything.
///
/// lineTotalCents is never client-supplied -- quoteRepository computes it
/// server-side from quantity * unitPriceCents, rounded once to the
/// nearest cent, on every create/update.
model QuoteLineItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  quoteId          String            @map("quote_id") @db.Uuid
  kind             QuoteLineItemKind
  description      String
  quantity         Float
  unitPriceCents   Int               @map("unit_price_cents")
  lineTotalCents   Int               @map("line_total_cents")
  sourceMaterialId String?           @map("source_material_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sourceMaterial Material?    @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quoteId])
  @@map("quote_line_items")
}
