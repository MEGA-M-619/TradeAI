// TradeAI schema.
// Phase 0: tenant/authentication foundation (organizations, users,
// organization_memberships).
// Phase 1 adds: customers, jobs.
// Every other domain table is added in later phases per the approved
// architecture.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url / directUrl are configured in prisma.config.ts (Prisma 7 pattern),
  // not here.
}

enum OrganizationRole {
  owner
  admin
  electrician

  @@map("organization_role")
}

/// A tenant. All tenant-scoped tables carry an organizationId that must
/// match app.current_org_id, enforced by both the repository layer and
/// PostgreSQL RLS (see prisma/migrations/*_tenant_rls/migration.sql).
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  customers   Customer[]
  jobs        Job[]

  @@map("organizations")
}

/// App-level profile for a Supabase Auth user. `id` is the same UUID as
/// the corresponding row in Supabase's auth.users table (linked via a raw
/// SQL foreign key added in the RLS migration, since auth.users lives
/// outside the schema Prisma manages). A user is never scoped to a single
/// organization — org access is entirely determined by
/// organization_memberships.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  jobsCreated Job[]

  @@map("users")
}

/// The join table that is the single source of truth for tenant access:
/// "is user X allowed to act within organization Y, and with what role."
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// A tenant's customer. organizationId is carried directly (not derived
/// via a join) so RLS policies can gate every command on it uniformly,
/// matching the pattern used throughout Phase 0.
model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@index([organizationId])
  @@map("customers")
}

/// Minimal lifecycle for Phase 1. Deliberately not modeling AI-assessment
/// or quote-related states yet -- those states belong to the phases that
/// actually implement AI assessment and quoting, and adding them now
/// would be designing for features that don't exist.
enum JobStatus {
  open
  in_progress
  completed

  @@map("job_status")
}

model Job {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  customerId          String    @map("customer_id") @db.Uuid
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  title               String
  problemDescription  String?   @map("problem_description")
  status              JobStatus @default(open)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([customerId])
  @@map("jobs")
}
