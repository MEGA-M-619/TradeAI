# Copy this file to .env.local and fill in real values.
# Never commit .env.local (or any file with real secrets) — .gitignore
# already excludes .env* except this example file.

# --- Database (Supabase Postgres) ---

# Pooled connection (Supavisor, transaction mode, port 6543). Used by the
# application at runtime. MUST authenticate as the least-privilege
# `app_user` role created in prisma/migrations/*_tenant_rls/migration.sql
# — never as `postgres`. See docs/architecture/security.md.
DATABASE_URL="postgresql://app_user:REPLACE_WITH_APP_USER_PASSWORD@REPLACE_WITH_PROJECT_REF.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432), bypassing the pooler. Used ONLY by
# `prisma migrate deploy` / `prisma migrate dev` to run schema migrations.
# Authenticates as the privileged Supabase `postgres` role. Never used by
# application runtime code, never exposed to the client.
DIRECT_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@db.REPLACE_WITH_PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase Auth ---

# Public: safe to expose to the browser (enforced by Supabase's own RLS/
# anon-key scoping, not by secrecy).
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_WITH_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_ANON_PUBLIC_KEY"

# Server-only secret. Never prefix with NEXT_PUBLIC_, never send to the
# client. Reserved for narrow administrative scripts (e.g. Supabase Admin
# API calls) — ordinary request handling must never use this to bypass
# tenant checks.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
